<%- include("partials/header") %>
    <main>
      <section class="hero-section" id="home">
        <div class="container">
          <div class="row align-items-center gy-5">
            <div class="col-lg-7">
              <span class="eyebrow"><span class="eyebrow-dot"></span> Your neighbourhood clinic in <%= area %></span>
              <h1>Good health starts<br class="d-none d-md-block"> with <span>feeling at home.</span></h1>
              <p class="hero-copy"><%= tagline %>. Thoughtful, expert care for you and your family, right here in your community.</p>
              <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-3">
                <a class="btn btn-primary btn-lg hero-booking" href="/booking">Book an appointment <i class="bi bi-arrow-up-right ms-2" aria-hidden="true"></i></a>
                <a class="hero-secondary" href="#specialties">Explore our specialties <i class="bi bi-arrow-down ms-1" aria-hidden="true"></i></a>
              </div>
              <div class="hero-trust"><i class="bi bi-heart-pulse-fill" aria-hidden="true"></i><span>Personal care. A healthier you.</span></div>
            </div>
            <div class="col-lg-5">
              <div class="hero-visual" role="img" aria-label="A calm, welcoming space for your health and wellbeing">
                <div class="visual-circle visual-circle-one"></div>
                <div class="visual-circle visual-circle-two"></div>
                <div class="visual-cross"><i class="bi bi-plus-lg" aria-hidden="true"></i></div>
                <div class="visual-card">
                  <span class="visual-card-icon"><i class="bi bi-heart-pulse" aria-hidden="true"></i></span>
                  <div><strong>Care that feels personal</strong><span>For every age, every stage</span></div>
                  <i class="bi bi-arrow-up-right visual-card-arrow" aria-hidden="true"></i>
                </div>
                <div class="visual-caption"><span class="caption-line"></span> Welcome to <%= clinicName %></div>
              </div>
            </div>
          </div>
        </div>
        <div class="hero-bottom-shape" aria-hidden="true"></div>
      </section>

      <section class="section specialties-section" id="specialties">
        <div class="container">
          <div class="section-heading text-center">
            <span class="eyebrow">Care for all of you</span>
            <h2>Our Specialties</h2>
            <p>Expert guidance and compassionate care, all under one roof.</p>
          </div>
          <div class="row g-4 specialty-grid">
            <div class="col-sm-6 col-lg-3">
              <article class="specialty-card">
                <span class="specialty-icon"><i class="bi bi-clipboard2-pulse" aria-hidden="true"></i></span>
                <h3>General Physician</h3>
                <p>Your first stop for everyday health, check-ups and trusted advice.</p>
                <span class="card-number">01</span>
              </article>
            </div>
            <div class="col-sm-6 col-lg-3">
              <article class="specialty-card">
                <span class="specialty-icon"><i class="bi bi-ear" aria-hidden="true"></i></span>
                <h3>ENT</h3>
                <p>Specialist care for your ears, nose and throat, with a gentle touch.</p>
                <span class="card-number">02</span>
              </article>
            </div>
            <div class="col-sm-6 col-lg-3">
              <article class="specialty-card">
                <span class="specialty-icon"><i class="bi bi-emoji-smile" aria-hidden="true"></i></span>
                <h3>Dentist</h3>
                <p>Keep your smile bright with comfortable, personalised dental care.</p>
                <span class="card-number">03</span>
              </article>
            </div>
            <div class="col-sm-6 col-lg-3">
              <article class="specialty-card">
                <span class="specialty-icon"><i class="bi bi-heart-pulse" aria-hidden="true"></i></span>
                <h3>Cardiologist</h3>
                <p>Heart health support, from prevention to specialist assessment.</p>
                <span class="card-number">04</span>
              </article>
            </div>
          </div>
        </div>
      </section>

      <section class="about-section" id="about">
        <div class="container">
          <div class="row align-items-center gy-5">
            <div class="col-lg-6">
              <div class="about-art" aria-hidden="true">
                <div class="about-orbit orbit-one"></div>
                <div class="about-orbit orbit-two"></div>
                <div class="about-heart"><i class="bi bi-heart-pulse-fill"></i></div>
                <div class="about-note"><i class="bi bi-check-circle-fill"></i> Care with you in mind</div>
                <span class="about-spark spark-one">✳</span><span class="about-spark spark-two">✳</span>
              </div>
            </div>
            <div class="col-lg-5 offset-lg-1">
              <span class="eyebrow">A little more about us</span>
              <h2>Care that puts <span>you first.</span></h2>
              <p class="about-copy"><%= clinicName %> is your friendly neighbourhood clinic in <%= area %>. We believe good healthcare begins with listening, and that every patient deserves to feel seen, supported and at ease.</p>
              <p class="about-copy">From your first check-up to ongoing specialist care, our team is here to make looking after your health feel a little simpler.</p>
              <a class="text-link" href="#contact">Come say hello <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i></a>
            </div>
          </div>
        </div>
      </section>

      <section class="contact-section section" id="contact">
        <div class="container">
          <div class="contact-panel">
            <div class="row g-5">
              <div class="col-lg-5">
                <span class="eyebrow eyebrow-light">We’re here for you</span>
                <h2>Let’s take care<br>of your health.</h2>
                <p>Questions or ready to book? Get in touch — we’d love to help.</p>
                <a class="btn btn-light btn-lg contact-cta" href="/booking">Book an appointment <i class="bi bi-arrow-up-right ms-2" aria-hidden="true"></i></a>
              </div>
              <div class="col-lg-6 offset-lg-1">
                <div class="contact-details" id="contact-details">
                  <div class="contact-item">
                    <span class="contact-icon"><i class="bi bi-geo-alt" aria-hidden="true"></i></span>
                    <div><h3>Visit us</h3><p><%= address %></p></div>
                  </div>
                  <div class="contact-item">
                    <span class="contact-icon"><i class="bi bi-telephone" aria-hidden="true"></i></span>
                    <div><h3>Call us</h3><p><%= phone %></p></div>
                  </div>
                  <div class="contact-item">
                    <span class="contact-icon"><i class="bi bi-clock" aria-hidden="true"></i></span>
                    <div><h3>Opening hours</h3><p>Mon–Sat, 9am–9pm<br>Closed Sunday</p></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
<%- include("partials/footer") %>
